---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroCarrusel from '../components/HeroCarrusel.astro';

const { 
  title, 
  description = 'Zapatillas, iPhones y tecnología. Explora el catálogo ZENP y consulta stock o importaciones por WhatsApp.' 
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#181a19" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg?v=original" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    
    <!-- Fuentes Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" 
      rel="stylesheet" 
    />
    
    <title>{title}</title>
  </head>

  <body>
    <!-- Enlace de accesibilidad para saltar directo al contenido -->
    <a 
      class="skip-link fixed -top-[70px] left-[15px] p-[10px] bg-white z-[100] focus:top-[15px] transition-all" 
      href="#contenido"
    >
      Saltar al contenido
    </a>

    <!-- Cabecera global -->
    <Header />
    

    <!-- Ranura para el contenido de cada página (index, catalogo, etc.) -->
    <slot />

    <!-- Pie de página global -->
    <Footer />
  </body>
</html>