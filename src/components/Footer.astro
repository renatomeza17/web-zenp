---
import IconoPago from './IconoPago.astro';
import { tienda, whatsappUrl, pagos } from '../data/tienda';
---

<footer class="site-footer [background:var(--ink)] [color:#c5c9c1] [padding:55px_0_20px] [&_.wordmark]:[color:white] max-[760px]:[padding-top:40px]">
  <div class="container [width:min(1240px,calc(100%_-_80px))] [margin:auto] max-[1100px]:[width:calc(100%_-_48px)] max-[760px]:[width:calc(100%_-_36px)]">
    
    <!-- Parte superior del footer -->
    <div class="footer-top [display:grid] [grid-template-columns:1.2fr_.8fr_1fr_1.2fr] [gap:45px] [padding-bottom:50px] [&_h2]:[font-size:11px] [&_h2]:[color:white] [&_h2]:[font-weight:500] [&_h2]:[margin:5px_0_20px] [&_p]:[font-size:11px] [&_p]:[line-height:1.9] [&_p]:[margin:18px_0] [&>div>a:not(.wordmark)]:[display:block] [&>div>a:not(.wordmark)]:[font-size:11px] [&>div>a:not(.wordmark)]:[margin:12px_0] max-[1100px]:[gap:25px] max-[760px]:[grid-template-columns:1fr_1fr] max-[760px]:[gap:30px_20px] max-[760px]:[&>div:last-child]:[grid-column:1/-1]">
      
      <!-- Columna 1: Marca y Redes Sociales -->
      <div>
        <img src="/logo.jpg" alt="Logo" class="w-18 h-18 rounded-full object-cover  mr-2" onerror="this.style.display='none'" />
        <p>
          Originales en stock y a pedido desde USA.<br />
          Punto de recojo en Miraflores.
        </p>
        
        <div class="socials flex-wrap [display:flex] [gap:10px] [&_a]:[border:1px_solid_#454b42] [&_a]:[padding:9px] [&_a]:[display:block] [&_img]:[filter:brightness(0)_invert(1)]">
          {tienda.redes.map(red => (
            <a href={red.url} target="_blank" rel="noopener noreferrer" aria-label={red.nombre}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                {red.nombre === 'Instagram' ? (
                  <>
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r=".7" fill="currentColor" />
                  </>
                ) : red.nombre === 'TikTok' ? (
                  <path d="M15 3v11.5a5.5 5.5 0 1 1-5-5.48v3.1a2.5 2.5 0 1 0 2 2.45V3h3c.4 2.6 2.4 4.5 5 4.8v3a9.5 9.5 0 0 1-5-1.8" stroke-linecap="round" stroke-linejoin="round"/>
                ) : (
                  <path d="M14 21v-8h3l.5-4H14V7c0-1 .5-2 2-2h2V2h-3c-3 0-5 2-5 5v2H7v4h3v8" />
                )}
              </svg>
            </a>
          ))}
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <img src="/brand-whatsapp.svg" width="20" height="20" alt="" />
          </a>
        </div>
      </div>

      <!-- Columna 2: Explora -->
      <div>
        <h2>Explora</h2>
        <a href="/catalogo/zapatillas/">Zapatillas</a>
        <a href="/catalogo/iphones/">iPhones</a>
        <a href="/catalogo/tecnologia/">Tecnología</a>
        <a href="/catalogo/?ofertas=1">Ofertas</a>
      </div>

      <!-- Columna 3: Ayuda y Enlaces -->
      <div>
        <h2>Estamos para ayudarte</h2>
        <a href="/nosotros/">Nosotros</a>
        <a href="/#como-comprar">Cómo comprar</a>
        <a href="/metodos-de-pago/">Métodos de pago</a>
        <a href="/preguntas-frecuentes/">Preguntas frecuentes</a>
        <a href="/contacto/">Contáctanos</a>
      </div>

      <!-- Columna 4: Contacto directo -->
      <div>
        <h2>Una conversación, tu próximo pedido.</h2>
        <p>
          Av. Angamos Oeste 1635, Miraflores.<br />
          
          Contraentrega en todo Lima
        </p>
        <a 
          class="footer-contact [color:#d9e8b8]!" 
          href={whatsappUrl()} 
          target="_blank" 
          rel="noopener noreferrer"
        >
          WhatsApp:  {tienda.whatsapp.slice(2)}
        </a>
      </div>

    </div>

    <!-- Una sola línea de cierre: copyright y símbolos de pago. -->
    <div class="flex flex-col items-start justify-between gap-4 border-t border-[#373c34] pt-5 sm:flex-row sm:items-center">
      <span class="text-[9px] text-[#8d9486]">© {new Date().getFullYear()} ZENP. Todos los derechos reservados.</span>
      <div class="flex max-w-full items-center gap-4 overflow-x-auto" aria-label="Métodos de pago">
        {pagos.metodos.map(metodo => <a href="/metodos-de-pago/" class="inline-flex h-10 shrink-0 items-center justify-center" title={metodo} aria-label={metodo}><IconoPago metodo={metodo}/></a>)}
      </div>
    </div>

  </div>
</footer>