---
// src/components/TrustBar.astro
const beneficios = [
  {
    icono: "🛡️",
    titulo: "100% Auténticos",
    desc: "Garantía de originalidad en sneakers y productos sellados Apple."
  },
  {
    icono: "📦",
    titulo: "Envíos a Todo el Perú",
    desc: "Entregas en Lima y envíos a provincia por Olva Courier o Shalom."
  },
  {
    icono: "⚡",
    titulo: "Separa con Adelanto",
    desc: "Asegura pedidos por encargo o reserva stock con el 10% a 20%."
  },
  {
    icono: "💬",
    titulo: "Atención por WhatsApp",
    desc: "Fotos, videos reales y confirmación de tallas antes del envío."
  }
];
---

<section class="max-w-6xl mx-auto px-4 py-8">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {beneficios.map((b) => (
      <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-zinc-200/80 shadow-xs hover:border-zinc-300 transition-all">
        <span class="text-2xl p-2.5 rounded-xl bg-zinc-100 flex items-center justify-center shrink-0">
          {b.icono}
        </span>
        <div>
          <h4 class="text-sm font-bold text-zinc-900 tracking-tight">{b.titulo}</h4>
          <p class="text-xs text-zinc-500 mt-0.5 leading-relaxed">{b.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>