---
import type { Producto } from '../data/productos';
import { etiquetaTalla } from '../lib/tallas';
import { tallasProducto, precioProducto, mensajeProducto, usaTallas } from '../lib/precios';
import { whatsappUrl } from '../data/tienda';
const { producto } = Astro.props as {producto?:Producto};
const opciones = producto ? usaTallas(producto) ? tallasProducto(producto) : producto.capacidad ? [producto.capacidad] : [] : [];
const seleccion = opciones[0] || '';
const pasos = [
  {titulo:'Elige el producto y tu talla.',texto:'Abre su ficha, revisa las fotos y selecciona tu talla o capacidad.'},
  {titulo:'Toca “Consultar por WhatsApp”.',texto:'Se abre el chat con el modelo, la talla y el precio listos. Revisa el mensaje y pulsa Enviar.'},
  {titulo:'Coordinamos contigo.',texto:'Confirmamos disponibilidad, forma de pago y opciones de entrega por chat.'},
];
---
<section id="como-comprar" aria-labelledby="como-comprar-titulo" class="mt-16 scroll-mt-28 bg-[#f2f3ed] sm:mt-20">
  <div class="container mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1fr_1fr] lg:gap-20 lg:px-8">
    <div><p class="mb-4 text-[10px] tracking-[2px] text-zinc-500 uppercase">De la ficha al chat</p><h2 id="como-comprar-titulo" class="font-['Space_Grotesk'] text-3xl font-medium leading-tight tracking-tight text-zinc-950 sm:text-4xl">Así de simple<br/>es comprar en ZENP.</h2>
      <ol class="mt-8 space-y-1">{pasos.map((paso,index)=><li><button type="button" data-buy-step={index} aria-controls={`compra-panel-${index}`} aria-pressed={index===0} class="group flex w-full items-start gap-4 border-b border-[#d9ddcf] px-0 py-5 text-left aria-pressed:border-zinc-900"><span class="mt-0.5 text-[10px] text-zinc-400 group-aria-pressed:text-zinc-900">0{index+1}</span><span><span class="block text-sm font-medium text-zinc-900">{paso.titulo}</span><span class="mt-2 block max-w-sm text-xs leading-6 text-zinc-500">{paso.texto}</span></span></button></li>)}</ol>
      <p class="mt-5 text-[10px] leading-5 text-zinc-500">Sin registro. Consulta directamente con nuestro equipo. <a href="/metodos-de-pago/" class="ml-1 border-b border-zinc-400 text-zinc-800">Métodos de pago</a></p>
    </div>
    <div data-buy-demo data-demo-product={producto ? JSON.stringify(producto) : undefined} class="self-center border border-[#dce0d4] bg-white p-5 shadow-[0_12px_50px_-30px_rgba(0,0,0,0.25)] sm:p-8">
      <div class="mb-5 flex items-center justify-between border-b border-zinc-100 pb-4"><span class="text-xs font-semibold tracking-wide text-zinc-950">ZENP / CÓMO COMPRAR</span><span class="text-[9px] tracking-wider text-zinc-400 uppercase">Ejemplo interactivo</span></div>
      <div id="compra-panel-0" data-buy-panel>
        {producto ? <><a href={`/producto/${producto.id}/`} class="mb-5 flex items-center gap-4"><img src={producto.imagenes[0] || '/producto-placeholder.svg'} alt={producto.nombre} width="120" height="120" class="h-24 w-24 shrink-0 object-contain" loading="lazy"/><div><p class="mb-1 text-[9px] tracking-wide text-zinc-400 uppercase">{producto.marca}</p><h3 class="text-sm font-medium leading-6 text-zinc-950">{producto.nombre}</h3></div></a>
        {opciones.length>0 && <label class="block text-[11px] text-zinc-500">{usaTallas(producto)?'Elige tu talla':'Capacidad'}<select data-demo-variant class="mt-2 w-full border border-zinc-200 bg-white px-3 py-3 text-xs text-zinc-950">{opciones.map(opcion=><option value={opcion}>{producto.categoria==='zapatillas'?etiquetaTalla(opcion):opcion}</option>)}</select></label>}
        <p data-demo-price class="mt-4 text-base font-semibold text-zinc-950">{precioProducto(producto,seleccion).texto}</p><button type="button" data-buy-next="1" class="mt-5 flex w-full items-center justify-between bg-zinc-950 px-4 py-3.5 text-xs text-white hover:bg-[#42745b]">Ver el mensaje preparado <span aria-hidden="true">→</span></button></> : <a href="/catalogo/" class="text-sm underline">Explora el catálogo para elegir tu producto</a>}
      </div>
      <div id="compra-panel-1" data-buy-panel class="mt-6">
        <p class="mb-3 text-xs font-medium text-zinc-950">Tu mensaje está listo.</p>
        <p data-demo-message class="border-l-2 border-[#78a56a] bg-[#eef5e9] p-4 text-xs leading-6 text-zinc-700">{producto ? mensajeProducto(producto,seleccion) : 'El mensaje incluirá el producto que elijas.'}</p>
        <p class="mt-4 text-[11px] leading-5 text-zinc-500">El sitio prepara el mensaje. Tú lo envías desde WhatsApp.</p>
        <a data-demo-whatsapp href={whatsappUrl(producto ? mensajeProducto(producto,seleccion) : undefined)} target="_blank" rel="noopener noreferrer" class="mt-5 flex items-center justify-between bg-zinc-950 px-4 py-3.5 text-xs text-white hover:bg-[#42745b]">Abrir WhatsApp <img src="/brand-whatsapp.svg" alt="" width="18" height="18" class="brightness-0 invert"/></a>
      </div>
      <div id="compra-panel-2" data-buy-panel class="mt-6">
        <p class="text-lg font-medium tracking-tight text-zinc-950">Terminamos de coordinar por chat.</p>
        <ul class="mt-5 space-y-4 text-xs leading-6 text-zinc-600"><li class="flex gap-3"><span class="text-[#42745b]">✓</span>Disponibilidad y precio final.</li><li class="flex gap-3"><span class="text-[#42745b]">✓</span>Forma de pago para tu pedido.</li><li class="flex gap-3"><span class="text-[#42745b]">✓</span>Recojo en Miraflores, contraentrega en Lima por S/ 10 o envío a tu ciudad.</li></ul>
        <a href={whatsappUrl('Hola ZENP, quisiera conocer las opciones de entrega para mi ciudad o distrito: ')} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block border-b border-zinc-900 pb-1 text-xs text-zinc-950">Consultar opciones de entrega</a>
        <p class="mt-4 text-[10px] leading-5 text-zinc-400">Recojo en Av. Angamos Oeste 1635, Miraflores, previa coordinación. El costo y plazo de envíos fuera de Lima se confirman por chat.</p>
      </div>
    </div>
  </div>
</section>
<script>
import type { Producto } from '../data/productos';
import { mensajeProducto, precioProducto } from '../lib/precios';
import { whatsappUrl } from '../data/tienda';
const steps = [...document.querySelectorAll<HTMLButtonElement>('[data-buy-step]')];
const panels = [...document.querySelectorAll<HTMLElement>('[data-buy-panel]')];
function showStep(index:number){panels.forEach((panel,i)=>panel.hidden=i!==index);steps.forEach((step,i)=>step.setAttribute('aria-pressed',String(i===index)));}
steps.forEach((step,index)=>step.addEventListener('click',()=>showStep(index)));
document.querySelectorAll<HTMLButtonElement>('[data-buy-next]').forEach(button=>button.addEventListener('click',()=>{const index=Number(button.dataset.buyNext);showStep(index);steps[index]?.focus({preventScroll:true});}));
const demo=document.querySelector<HTMLElement>('[data-buy-demo]');
if(demo?.dataset.demoProduct){
 const producto:Producto=JSON.parse(demo.dataset.demoProduct);
 const select=demo.querySelector<HTMLSelectElement>('[data-demo-variant]');
 function update(){const opcion=select?.value||'';demo!.querySelector('[data-demo-price]')!.textContent=precioProducto(producto,opcion).texto;demo!.querySelector('[data-demo-message]')!.textContent=mensajeProducto(producto,opcion);demo!.querySelector<HTMLAnchorElement>('[data-demo-whatsapp]')!.href=whatsappUrl(mensajeProducto(producto,opcion));}
 select?.addEventListener('change',update);update();
}
if(panels.length)showStep(0);
</script>
