
---
// src/components/Header.astro
import { whatsappUrl } from '../data/tienda';

import { getProductos } from '../lib/catalogo';
import { menuCatalogo } from '../lib/navegacion';
const navMenu = menuCatalogo(await getProductos());
---

<!-- Cinta de anuncios superior -->
<div class="announcement text-center bg-[#101211] text-[#bbbfb9] text-[10px] tracking-[1px] py-[9px] px-[15px] [&_span]:px-[14px] max-[1279px]:text-[8px] max-[1279px]:tracking-[0.3px] max-[1279px]:[&_span]:px-[5px]">
  Contra entrega en Lima <span>·</span> Envíos a todo el Perú
</div>

<!-- Header Principal -->
<header class="site-header bg-[var(--ink,#121312)] text-white sticky top-0 z-40 border-b border-[#252826]">
  <div class="container header-inner w-[min(1240px,calc(100%_-_80px))] mx-auto h-[80px] flex items-center gap-[24px] max-[1100px]:w-[calc(100%_-_48px)] max-[1100px]:gap-[16px] max-[1279px]:w-[calc(100%_-_36px)] max-[1279px]:h-[65px]">
    
    <!-- Logo -->
    <a href="/" class="wordmark font-['Space_Grotesk',sans-serif] text-[34px] font-bold tracking-[-2px] inline-flex items-center shrink-0 max-[1279px]:text-[29px]" aria-label="ZENP, inicio">
      <img src="/logo.jpg" alt="Logo" class="w-15 h-15 rounded-full object-cover  mr-2" onerror="this.style.display='none'" />
      <!-- <span>ZENP<span class="text-emerald-400">.</span></span> -->
    </a>

    <!-- Navegación Escritorio con Desplegables en Hover -->
    <nav class="desktop-nav flex gap-[18px] ml-[12px] text-[12px] font-medium max-[1100px]:ml-[10px] max-[1100px]:gap-[16px] max-[1279px]:hidden" aria-label="Principal">
      {navMenu.map((item) => (
        <div class="relative group py-6">
          <a href={item.enlace} class="text-[#c8cbc6] group-hover:text-white transition flex items-center gap-1.5 cursor-pointer">
            {item.titulo}
            <svg class="w-3 h-3 text-[#797d75] group-hover:text-white group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <!-- Submenú desplegable flotante -->
          <div class="absolute left-0 top-full hidden group-hover:flex group-focus-within:flex flex-col bg-[#161817] border border-[#2d312e] rounded-xl p-2 w-52 max-h-[70vh] overflow-y-auto shadow-2xl z-50">
            {/* <span class="text-[9px] font-bold uppercase tracking-wider text-[#797d75] px-3 py-1.5">Modelos / Opciones</span> */}
            {item.marcas.map((marca) => (
              <a href={marca.href} class="px-3 py-2 text-xs rounded-lg text-[#c8cbc6] hover:bg-[#222624] hover:text-emerald-400 transition">
                {marca.nombre}
              </a>
            ))}
          </div>
        </div>
      ))}
      <div class="py-6">
        <a href="/nosotros/" class="text-[#c8cbc6] hover:text-white transition">Nosotros</a>
      </div>
      <div class="py-6"><a href="/#como-comprar" class="whitespace-nowrap text-[#c8cbc6] transition hover:text-white">Cómo comprar</a></div>
      <div class="py-6"><a href="/metodos-de-pago/" class="whitespace-nowrap text-[#c8cbc6] transition hover:text-white">Métodos de pago</a></div>
    </nav>

    <!-- Buscador Integrado (Input interactivo para PC) -->
    <div class="header-search ml-auto relative flex items-center w-40 xl:w-64 min-w-0 max-[1279px]:hidden">
      <svg class="w-4 h-4 text-[#a3a69f] absolute left-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <circle cx="10.5" cy="10.5" r="7" stroke-width="1.5"/>
        <path d="m16 16 5 5" stroke-width="1.5"/>
      </svg>
      <input 
        type="text" 
        id="header-search-desktop" aria-label="Buscar en todo el catálogo"
        placeholder="Buscar modelo o marca..." 
        class="w-full bg-[#181a19] text-white text-xs pl-8 pr-3 py-1.5 rounded-lg border border-[#3b3f3c] focus:outline-none focus:border-emerald-400 placeholder-[#797d75] transition"
      />
    </div>

    <!-- Acciones Móvil & WhatsApp -->
    <div class="flex items-center gap-2 ml-auto min-[1280px]:ml-0">
      <!-- Botón de Lupa en Móvil -->
      <button 
        id="btn-toggle-search-mobile" 
        type="button" 
        class="hidden max-[1279px]:flex items-center justify-center p-2 rounded-lg text-[#a3a69f] hover:text-white bg-[#181a19] border border-[#3b3f3c]"
        aria-label="Abrir buscador" aria-controls="search-bar-mobile" aria-expanded="false"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="10.5" cy="10.5" r="7" stroke-width="1.5"/>
          <path d="m16 16 5 5" stroke-width="1.5"/>
        </svg>
      </button>

      <!-- Botón WhatsApp -->
      <a 
        class="header-wa flex gap-[8px] items-center text-[12px] py-[10px] px-[16px] bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl max-[1279px]:p-[9px] transition active:scale-95 shadow-lg shadow-emerald-500/20"
        aria-label="Consultar por WhatsApp" 
        href={whatsappUrl()} 
        target="_blank" 
        rel="noopener noreferrer"
      >
        <img src="/brand-whatsapp.svg" width="18" height="18" alt="" class="brightness-0 invert" />
        <span class="max-[1279px]:hidden">Hablemos</span>
      </a>

      <!-- Botón Hamburguesa Móvil -->
      <button 
        class="menu-toggle hidden max-[1279px]:block bg-transparent border-none text-white text-[24px] p-1 cursor-pointer" 
        aria-label="Abrir menú" 
        aria-expanded="false" 
        aria-controls="mobile-nav"
      >
        ☰
      </button>
    </div>
  </div>

  <!-- Barra de Búsqueda Desplegable para Móvil -->
  <div id="search-bar-mobile" hidden class="min-[1280px]:hidden border-t border-[#2d312e] bg-[#141615] px-4 py-2.5">
    <div class="relative flex items-center">
      <svg class="w-4 h-4 text-[#a3a69f] absolute left-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <circle cx="10.5" cy="10.5" r="7" stroke-width="1.5"/>
        <path d="m16 16 5 5" stroke-width="1.5"/>
      </svg>
      <input 
        type="text" 
        id="header-search-mobile" aria-label="Buscar en todo el catálogo"
        placeholder="¿Qué estás buscando?..." 
        class="w-full bg-[#1b1e1d] text-white text-xs pl-9 pr-3 py-2 rounded-lg border border-[#3b3f3c] focus:outline-none focus:border-emerald-400 placeholder-[#797d75]"
      />
    </div>
  </div>

  <!-- Menú Móvil Desplegable -->
  <nav id="mobile-nav" class="mobile-nav py-4 px-6 border-t border-[#2d312e] text-sm bg-[#121312] space-y-3" aria-label="Navegación móvil" hidden>
    <a href="/catalogo/" class="block text-emerald-400 font-bold py-1">Ver todo el catálogo</a>
    
    {navMenu.map((cat) => (
      <details class="group border-b border-[#222523] pb-2">
        <summary class="flex justify-between items-center py-1.5 text-white cursor-pointer list-none font-medium">
          <span>{cat.titulo}</span>
          <svg class="w-4 h-4 text-[#797d75] group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="pl-3 pt-1 space-y-1.5 text-xs text-[#a3a69f]">
          <a href={cat.enlace} class="block py-1 font-medium text-white">Ver todo en {cat.titulo.toLowerCase()}</a>
          {cat.marcas.map((m) => (
            <a href={m.href} class="block py-1 hover:text-emerald-400">{m.nombre}</a>
          ))}
        </div>
      </details>
    ))}

    <a href="/nosotros/" class="block py-1.5 text-[#c8cbc6]">Nosotros</a>
    <a href="/contacto/" class="block py-1.5 text-[#c8cbc6]">Contacto</a>
    <a href="/#como-comprar" class="block py-1.5 text-[#c8cbc6]">Cómo comprar</a>
    <a href="/metodos-de-pago/" class="block py-1.5 text-[#c8cbc6]">Métodos de pago</a>
  </nav>
</header>

<script>
  import { urlCatalogo } from '../lib/navegacion';
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-nav');
  const searchToggle = document.querySelector<HTMLButtonElement>('#btn-toggle-search-mobile');
  const searchBar = document.querySelector<HTMLElement>('#search-bar-mobile');
  const inputs = ['header-search-desktop','header-search-mobile'].map(id => document.getElementById(id) as HTMLInputElement | null);
  toggle?.addEventListener('click', () => { if (menu) {menu.hidden = !menu.hidden;toggle.setAttribute('aria-expanded',String(!menu.hidden));} });
  searchToggle?.addEventListener('click', () => {if (searchBar) {searchBar.hidden = !searchBar.hidden;searchToggle.setAttribute('aria-expanded',String(!searchBar.hidden));if (!searchBar.hidden) inputs[1]?.focus();} });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    if (menu && toggle && !menu.hidden) {menu.hidden = true;toggle.setAttribute('aria-expanded','false');toggle.focus();}
    if (searchBar && searchToggle && !searchBar.hidden) {searchBar.hidden = true;searchToggle.setAttribute('aria-expanded','false');searchToggle.focus();}
  });
  inputs.forEach(input => {
    if (!input) return;
    input.value = new URLSearchParams(location.search).get('q') || '';
    input.addEventListener('input', () => {
      inputs.forEach(other => {if (other && other !== input) other.value = input.value;});
      // Only the catalog controls filtering, counts and pagination.
      document.dispatchEvent(new CustomEvent('catalog:search',{detail:input.value}));
    });
    input.addEventListener('keydown', event => {
      if (event.key === 'Enter') { event.preventDefault();location.href = urlCatalogo('',{q:input.value.trim()}); }
    });
  });
  document.addEventListener('catalog:query', event => {
    inputs.forEach(input => {if (input) input.value = (event as CustomEvent<string>).detail;});
  });
</script>
