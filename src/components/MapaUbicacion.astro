---
import { entregas } from '../data/tienda';
const mapaEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(entregas.direccion + ', Perú')}&z=16&output=embed`;
---
<section aria-labelledby="ubicacion-titulo" class="mt-10 grid min-w-0 overflow-hidden border border-zinc-200 bg-[#f6f6f3] md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
  <div class="flex flex-col items-start justify-center p-6 sm:p-8">
    <p class="mb-3 text-[10px] font-medium uppercase tracking-[2px] text-zinc-500">Punto de recojo</p>
    <h2 id="ubicacion-titulo" class="font-['Space_Grotesk'] text-2xl font-medium tracking-tight text-zinc-900">Estamos en Miraflores.</h2>
    <p class="mt-3 text-xs leading-6 text-zinc-600">{entregas.direccion}.</p>
    <!-- <p class="mt-2 text-xs leading-6 text-zinc-500">Recojo previa coordinación por WhatsApp.</p> -->
    <a href={entregas.mapa} target="_blank" rel="noopener noreferrer" class="mt-4 border-b border-zinc-400 pb-1 text-xs text-zinc-800">Abrir ubicación en Google Maps</a>
  </div>
  <iframe title={`Ubicación del punto de recojo ZENP: ${entregas.direccion}`} src={mapaEmbed} width="600" height="260" class="h-[260px] w-full min-w-0 border-0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
</section>
