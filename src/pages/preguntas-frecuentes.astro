---
import Layout from '../layouts/Layout.astro';
import { whatsappUrl } from '../data/tienda';
const preguntas = [
['¿Cómo compro un producto?','Explora el catálogo, elige tu talla o capacidad y pulsa el botón de WhatsApp. El mensaje incluirá los datos del producto. Nuestro equipo confirmará la disponibilidad, el precio final y la entrega antes de coordinar el pago.'],
['¿Qué significa En stock, A pedido y Agotado?','En stock indica disponibilidad registrada en el catálogo; confírmala por WhatsApp antes de pagar. A pedido significa que podemos consultar su compra o importación. Agotado indica que actualmente no está disponible; puedes preguntar por su reposición.'],
['¿Pueden traer un modelo que no aparece aquí?','Sí, puedes enviarnos el nombre o una foto de referencia. Para zapatillas, indica la talla; para iPhones, el modelo, capacidad y condición deseada. Revisaremos si hay opciones para traerlo a pedido.'],
['¿Cuánto demora una importación?','El plazo depende del producto, origen y disponibilidad. Te comunicaremos una estimación y las condiciones del pedido antes de reservar. Consulta las actualizaciones directamente con nuestro equipo.'],
['¿Los iPhones son sellados o seminuevos?','El catálogo indica la condición de cada equipo. Los seminuevos pueden incluir información de batería. Consulta por WhatsApp los detalles del dispositivo, compatibilidad, accesorios y garantía aplicable antes de comprar.'],
['¿Hacen envíos a provincias?','Coordinamos envíos dentro del Perú. El costo, operador y tiempo de entrega se confirman según tu destino y el producto. Envíanos tu ciudad o distrito para revisar las opciones.'],
['¿Qué métodos de pago aceptan?','Consulta los métodos disponibles, la separación y los datos de pago directamente en nuestro WhatsApp oficial. Confirmaremos las condiciones antes de que realices un abono.'],
['¿Cómo funcionan los cambios y la garantía?','Las condiciones dependen del tipo de producto y su estado. Antes de pagar, pide a nuestro equipo los términos de cambios y garantía aplicables a tu compra.']
];
---
<Layout title="Preguntas frecuentes — ZENP"><main id="contenido" class="container content-page [width:min(1240px,calc(100%_-_80px))] [margin:auto] [padding:55px_0_90px] max-[1100px]:[width:calc(100%_-_48px)] max-[760px]:[width:calc(100%_-_36px)] max-[760px]:[padding-top:35px]"><p class="breadcrumb [font-size:10px] [color:var(--muted)] [margin-bottom:45px] max-[760px]:[margin-bottom:30px]"><a href="/">Inicio</a> / Preguntas frecuentes</p><div class="page-heading [margin-bottom:35px] [&_h1]:[font-family:'Space_Grotesk'] [&_h1]:[font-size:64px] [&_h1]:[letter-spacing:-3px] [&_h1]:[line-height:1.1] [&_h1]:[font-weight:500] [&>p:last-child]:[font-size:14px] [&>p:last-child]:[color:var(--muted)] [&>p:last-child]:[line-height:1.8] [&>p:last-child]:[margin-top:15px] max-[760px]:[&_h1]:[font-size:48px] max-[760px]:[&_h1]:[letter-spacing:-2px]"><p class="eyebrow [font-size:10px] [text-transform:uppercase] [letter-spacing:1.8px] [font-weight:600] [color:var(--muted)] [display:block] [margin-bottom:18px]">Antes de tu próximo pedido</p><h1>Todo más claro<span class="accent [color:var(--green)]">.</span></h1><p>Resolvemos tus dudas sobre productos, pedidos y entregas.</p></div><div class="faq-list [max-width:850px] [margin:40px_0] [&_details]:[border-bottom:1px_solid_var(--line)] [&_details]:[padding:22px_0] [&_summary]:[font-size:16px] [&_summary]:[cursor:pointer] [&_details_p]:[line-height:1.9] [&_details_p]:[color:var(--muted)] [&_details_p]:[margin-top:18px] [&_details_p]:[max-width:730px] max-[760px]:[&_summary]:[font-size:14px]">{preguntas.map(([pregunta,respuesta]) => <details><summary>{pregunta}</summary><p>{respuesta}</p></details>)}</div><a class="button dark [display:inline-flex] [align-items:center] [justify-content:center] [gap:18px] [padding:15px_22px] [font-size:12px] [font-weight:500] [border:0] [background:var(--ink)] [color:white] [&:hover]:[background:var(--green)] [&:hover]:[color:white]" href={whatsappUrl('Hola ZENP, tengo una pregunta sobre una compra.')} target="_blank" rel="noopener noreferrer">Tengo otra pregunta ↗</a></main></Layout>
