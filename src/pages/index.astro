---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import SeccionProductos from '../components/SeccionProductos.astro';
import { precioProducto } from '../lib/precios';
import { urlCatalogo } from '../lib/navegacion';
import { getProductos } from '../lib/catalogo';
import { categorias, whatsappUrl } from '../data/tienda';
import HeroCarrusel from '../components/HeroCarrusel.astro';

const productos = await getProductos();
const disponibles = productos.filter(p => p.estado !== 'agotado');
const destacados = disponibles.filter(p => p.destacado);
const novedades = (destacados.length ? destacados : disponibles).slice(0,4);
const idsNovedades = new Set(novedades.map(p => p.id));
const stock = productos.filter(p => p.estado === 'stock');
const enStock = [...stock.filter(p => !idsNovedades.has(p.id)), ...stock.filter(p => idsNovedades.has(p.id))].slice(0,4);
const aPedido = productos.filter(p => p.estado === 'pedido').slice(0,4);
const ofertas = disponibles.filter(p => precioProducto(p).descuento).slice(0,4);
---

<Layout title="ZENP — Sneakers, iPhones & tecnología">
  <main id="contenido">
    
    <!-- 1. Hero Carrusel Principal -->
    <HeroCarrusel />

    <!-- 2. Sección Hero Alternativo / Presentación -->
    

    <!-- 3. Franja de Servicios / Beneficios -->
    <div class="border-y border-[var(--line)] bg-[var(--paper)] hidden md:block">
      <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 text-xs text-[var(--muted)]">
        <span class="text-[10px] max-[760px]:text-[8px] flex items-center justify-center text-center">
          01 <strong class="font-medium text-[var(--ink)] mx-3 max-[1100px]:block max-[1100px]:my-1">Elige a tu manera</strong> Stock o a pedido
        </span>
        <span class="text-[10px] max-[760px]:text-[8px] flex items-center justify-center text-center">
          02 <strong class="font-medium text-[var(--ink)] mx-3 max-[1100px]:block max-[1100px]:my-1">Hablemos por WhatsApp</strong> Atención personalizada
        </span>
        <span class="text-[10px] max-[760px]:text-[8px] flex items-center justify-center text-center">
          03 <strong class="font-medium text-[var(--ink)] mx-3 max-[1100px]:block max-[1100px]:my-1">Coordinamos tu entrega</strong> Envíos a todo el Perú
        </span>
      </div>
    </div>

    <!-- 4. Cuadrícula de Categorías (Estilo Lookbook / Editorial) -->
<section class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 md:pt-20 pb-4">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-7 gap-5">
    <div>
      <p class="text-[10px] uppercase tracking-[1.8px] font-semibold text-[var(--muted,#71717a)] mb-2.5">
        Tres mundos. Un solo lugar.
      </p>
      <h2 class="font-['Space_Grotesk',sans-serif] font-medium text-3xl sm:text-4xl tracking-tight leading-tight text-zinc-900">
        ¿Qué estás buscando?
      </h2>
    </div>
    <a class="text-xs border-b border-[#bbbfb7] pb-1 hover:border-zinc-900 transition-colors" href="/catalogo/">
      Ver todo el catálogo
    </a>
  </div>

  <!-- Rejilla de 3 Banners de Categoría Grandes -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
    {categorias.map((c, i) => (
      <a 
        href={`/catalogo/${c.slug}/`}
        class="group relative aspect-[3/4] sm:aspect-[4/5] md:aspect-[4/4] w-full overflow-hidden bg-zinc-950 block"
      >
        <!-- Imagen de Portada de la Categoría en Alta Resolución -->
        <img 
          src={
            c.slug === 'zapatillas'
              ? 'https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=1000&q=85'
              : c.slug === 'iphones'
              ? '/Iphones18.jpg'
              : '/0.webp'
          } 
          alt={c.nombre}
          loading="lazy"
          decoding="async"
          width="1000" height="1000"
          class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
        />

        <!-- Sombra gradual en la base para lectura perfecta -->
        {/* <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"></div> */}

        <!-- Indicador de número en la esquina superior derecha -->
        {/* <span class="absolute top-4 right-4 text-[11px] font-bold tracking-widest text-white/70 select-none">
          0{i + 1}
        </span> */}

        <!-- Textos tipográficos en la esquina inferior izquierda  -->
        <div class="absolute inset-x-0 bottom-0 p-6 flex flex-col justify-end">
          {/* <span class="text-[10px] uppercase font-bold tracking-widest text-white mb-1">
            {c.etiqueta || 'Colección'}
          </span> */}
          <h3 class="font-['Space_Grotesk',sans-serif] text-2xl sm:text-3xl font-black text-white tracking-tight uppercase leading-none">
            {c.nombre}
          </h3>
          {/* <p class="text-xs text-zinc-300 font-normal tracking-wide mt-2 opacity-90 line-clamp-1">
            Explorar modelos & drops ↗
          </p> */}
        </div>
      </a>
    ))}
  </div>
</section>

    <SeccionProductos id="novedades" titulo="Novedades" subtitulo="La selección ZENP" enlace="/catalogo/" textoEnlace="Encuentra tu favorito" productos={novedades}/>
    <SeccionProductos id="disponibles" titulo="Disponibles ahora" subtitulo="En stock, sin esperar una importación" enlace={urlCatalogo('',{state:'stock'})} textoEnlace="Ver productos en stock" productos={enStock}/>
    <SeccionProductos id="a-pedido" titulo="A pedido" subtitulo="Vale la pena buscarlo" enlace={urlCatalogo('',{state:'pedido'})} textoEnlace="Explorar a pedido" productos={aPedido}/>
    <SeccionProductos id="ofertas" titulo="Precios especiales" subtitulo="Una buena oportunidad" enlace={urlCatalogo('',{ofertas:'1'})} textoEnlace="Ver todas las ofertas" productos={ofertas}/>

    <!-- 6. Sección de Importaciones a Pedido -->
    <section class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 md:mt-24 bg-[#eef1e9] p-6 sm:p-14 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-20">
      <div>
        <p class="text-[10px] uppercase tracking-[1.8px] font-semibold text-[var(--muted)] mb-4.5">
          No está en el catálogo. Todavía.
        </p>
        <h2 class="font-['Space_Grotesk',sans-serif] font-medium text-3xl sm:text-4xl tracking-tight leading-tight text-zinc-900">
          Tú lo encuentras.<br />Nosotros lo buscamos.
        </h2>
        <p class="text-[#687061] text-sm leading-relaxed my-5 max-w-md">
          ¿Un par especial o un iPhone de Estados Unidos? Envíanos el modelo que tienes en mente y consultamos las opciones para traerlo a pedido.
        </p>
        <a 
          class="inline-flex items-center justify-center gap-4 py-3.5 px-5.5 text-xs font-medium bg-[var(--ink)] text-white hover:bg-[var(--green)] hover:text-white transition-colors" 
          href={whatsappUrl('Hola ZENP, busco un producto para traer a pedido. Modelo: ')} 
          target="_blank" 
          rel="noopener noreferrer"
        >
          Consultar una importación
        </a>
      </div>

      <div class="order-steps space-y-6">
        <div class="relative pl-10 pb-6 border-b border-[#d3d9cd]">
          <span class="absolute left-0 top-0.5 text-xs text-[#858f7d]">01</span>
          <h3 class="text-sm font-medium mb-2 text-zinc-900">Cuéntanos qué buscas</h3>
          <p class="text-xs leading-relaxed text-[#70776b]">Comparte el modelo, talla o capacidad. Una foto de referencia también ayuda.</p>
        </div>
        <div class="relative pl-10 pb-6 border-b border-[#d3d9cd]">
          <span class="absolute left-0 top-0.5 text-xs text-[#858f7d]">02</span>
          <h3 class="text-sm font-medium mb-2 text-zinc-900">Revisa nuestra propuesta</h3>
          <p class="text-xs leading-relaxed text-[#70776b]">Confirmamos precio, disponibilidad y plazo estimado antes de reservar.</p>
        </div>
        <div class="relative pl-10">
          <span class="absolute left-0 top-0.5 text-xs text-[#858f7d]">03</span>
          <h3 class="text-sm font-medium mb-2 text-zinc-900">Coordinamos contigo</h3>
          <p class="text-xs leading-relaxed text-[#70776b]">Acordamos el pago y la entrega de tu pedido por WhatsApp.</p>
        </div>
      </div>
    </section>

    <!-- 7. Teaser "Sobre Nosotros" -->
    <section class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 text-center">
      <p class="text-[10px] uppercase tracking-[1.8px] font-semibold text-[var(--muted)] mb-4.5">
        Esto es ZENP
      </p>
      <h2 class="font-['Space_Grotesk',sans-serif] font-medium text-3xl sm:text-4xl tracking-tight leading-tight my-5 text-zinc-900">
        Nos gustan los buenos pares.<br />Y las buenas conexiones.
      </h2>
      <a class="text-xs border-b border-[#bbbfb7] pb-1 hover:border-zinc-900 transition-colors inline-block" href="/nosotros/">
        Conócenos un poco más
      </a>
    </section>

  </main>
</Layout>