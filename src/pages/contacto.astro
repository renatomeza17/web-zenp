---
import Layout from '../layouts/Layout.astro';
import MapaUbicacion from '../components/MapaUbicacion.astro';
import IconoRed from '../components/IconoRed.astro';
import { tienda, whatsappUrl } from '../data/tienda';
---
<Layout title="Contáctanos — ZENP" description="Conversa con ZENP por WhatsApp. Recojo en Miraflores, contraentrega en Lima por S/ 10 y envíos a todo el Perú.">
  <main id="contenido" class="mx-auto max-w-7xl px-5 pt-9 pb-16 sm:px-8 sm:pt-14 sm:pb-20">
    <nav aria-label="Ruta de navegación" class="mb-9 text-[11px] text-zinc-500"><a href="/" class="hover:text-zinc-900">Inicio</a> / Contacto</nav>
    <header class="mb-9 sm:mb-12">
      <p class="mb-4 text-[10px] font-semibold uppercase tracking-[2px] text-zinc-500">Directo con ZENP</p>
      <h1 class="font-['Space_Grotesk'] text-5xl font-medium tracking-tight text-zinc-950 sm:text-6xl">Hablemos<span class="text-[#42745b]">.</span></h1>
      <p class="mt-4 max-w-lg text-sm leading-7 text-zinc-500">Escríbenos por WhatsApp o prepara tu consulta desde aquí.</p>
    </header>

    <div class="grid min-w-0 items-start gap-9 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
      <section aria-labelledby="contacto-directo" class="min-w-0">
        <h2 id="contacto-directo" class="text-sm font-medium text-zinc-900">Contacto directo</h2>
        <div class="mt-5">
          <p class="mb-2 text-xs text-zinc-500">WhatsApp</p>
          <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 text-zinc-900 transition-opacity hover:opacity-70">
            <img src="/redes/whatsapp.svg" width="44" height="44" alt="" class="h-11 w-11 shrink-0 object-contain"/>
            <span class="font-['Space_Grotesk'] text-3xl font-medium leading-none tracking-tight">934 870 906</span>
          </a>
        </div>
        <div class="mt-7">
          <h3 class="text-xs font-medium text-zinc-900">Redes sociales</h3>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {tienda.redes.map(red=><a href={red.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 py-3 pr-4 text-sm text-zinc-700 transition-opacity hover:opacity-70"><IconoRed nombre={red.nombre}/>{red.nombre}</a>)}
          </div>
        </div>

      </section>

      <section class="min-w-0 border border-zinc-200 bg-[#f6f6f3] p-6 sm:p-8" aria-labelledby="consulta-titulo">
        <h2 id="consulta-titulo" class="font-['Space_Grotesk'] text-2xl font-medium tracking-tight text-zinc-900">Tu consulta</h2>
        <form id="contact-form" class="mt-6 grid gap-5 [&_label]:text-xs [&_label]:font-medium [&_label]:text-zinc-800 [&_input]:mt-2 [&_input]:block [&_input]:w-full [&_input]:min-w-0 [&_input]:border [&_input]:border-zinc-300 [&_input]:bg-white [&_input]:px-3 [&_input]:py-3 [&_input]:font-normal [&_textarea]:mt-2 [&_textarea]:block [&_textarea]:w-full [&_textarea]:resize-y [&_textarea]:border [&_textarea]:border-zinc-300 [&_textarea]:bg-white [&_textarea]:px-3 [&_textarea]:py-3 [&_textarea]:font-normal [&_input]:focus:outline-[#42745b] [&_textarea]:focus:outline-[#42745b]">
          <label>Tu nombre<input name="nombre" required maxlength="80" autocomplete="given-name" placeholder="¿Cómo te llamas?"/></label>
          <label>Ciudad o distrito<input name="ciudad" required maxlength="100" autocomplete="address-level2" placeholder="¿Dónde recibirías tu pedido?"/></label>
          <label>Tu consulta<textarea name="mensaje" required maxlength="1500" rows="4" placeholder="Modelo, talla, capacidad o cualquier duda…"></textarea></label>
          <button type="submit" class="flex items-center justify-center gap-3 bg-zinc-900 px-5 py-3.5 text-xs font-medium text-white transition-colors hover:bg-[#42745b] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#42745b]">Continuar en WhatsApp<img src="/brand-whatsapp.svg" width="18" height="18" alt=""/></button>
          <p class="text-[11px] leading-5 text-zinc-500">Se abrirá WhatsApp con tu mensaje preparado para que lo revises y envíes. Este formulario no almacena tus datos.</p>
        </form>
      </section>
    </div>
    <MapaUbicacion/>

  </main>
</Layout>

<script>
  import { whatsappUrl } from '../data/tienda';

  document
    .querySelector<HTMLFormElement>('#contact-form')
    ?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const data = new FormData(form);

      const mensaje = `Hola ZENP, soy ${data.get('nombre')}. Ciudad/distrito: ${data.get('ciudad')}. Consulta: ${data.get('mensaje')}`;
      location.href = whatsappUrl(mensaje);
    });
</script>