---
import Layout from '../../layouts/Layout.astro';
import { getProductos, modoDemo } from '../../lib/catalogo';
import type { Producto } from '../../data/productos';
import GuiaTallas from '../../components/GuiaTallas.astro';
import { etiquetaTalla } from '../../lib/tallas';
import { precioProducto, mensajeProducto, formatearPrecio, generoEtiqueta, tallasProducto, esTallaAPedido, usaTallas } from '../../lib/precios';
import { whatsappUrl, categorias } from '../../data/tienda';

export async function getStaticPaths() {
  return (await getProductos()).map((producto) => ({
    params: { id: String(producto.id) },
    props: { producto }
  }));
}

const { producto: p } = Astro.props as { producto: Producto };
const categoria = categorias.find((c) => c.slug === p.categoria)!;
const imagenes = p.imagenes.length ? p.imagenes : ['/producto-placeholder.svg'];
const precio = precioProducto(p);
const estado = {
  stock: 'En stock',
  pedido: 'A pedido / importación',
  agotado: 'Agotado'
}[p.estado];

const opciones = usaTallas(p) ? tallasProducto(p) : p.capacidad ? [p.capacidad] : [];
const seleccionInicial = usaTallas(p) ? '' : opciones[0] || '';
const variante = usaTallas(p) ? 'Talla' : 'Capacidad';

const mensaje = mensajeProducto(p, seleccionInicial);

const descripcion =
  p.descripcion ||
  `Consulta los detalles del ${p.nombre} con nuestro equipo. Te confirmamos disponibilidad, características y condiciones de entrega antes de reservar.`;
---

<Layout title={`${p.nombre} — ZENP`} description={descripcion}>
  <main
    id="contenido"
    data-product={JSON.stringify(p)}
    class="mx-auto w-[calc(100%_-_36px)] max-w-[1240px] pt-8 pb-20 md:w-[calc(100%_-_80px)]"
  >
    <!-- Migas de pan / Breadcrumb -->
    <nav class="mb-10 flex flex-wrap gap-2 text-[11px] text-[#747773]" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-[#181a19]">Inicio</a>
      <span>/</span>
      <a href={`/catalogo/${p.categoria}/`} class="hover:text-[#181a19]">{categoria.nombre}</a>
      <span>/</span>
      <span aria-current="page">{p.nombre}</span>
    </nav>

    <div class="grid min-w-0 grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-20">
      
      <!-- Columna 1: Galería de Imágenes -->
      <section class="min-w-0" aria-label={`Fotografías de ${p.nombre}`}>
        <!-- Foto principal activa -->
        <div class="relative aspect-square w-full overflow-hidden bg-white">
          <img
            id="product-main-image"
            src={imagenes[0]}
            alt={`${p.nombre}, foto 1 de ${imagenes.length}`}
            width="1000"
            height="1000"
            class="absolute inset-0 h-full w-full max-w-full object-contain"
            fetchpriority="high"
          />
          <span
            class="absolute right-4 bottom-4 bg-white/90 px-3 py-2 text-[11px] text-[#747773]"
            id="photo-counter"
          >
            1 / {imagenes.length}
          </span>
        </div>

        <!-- Carrusel de Miniaturas -->
        <div class="mt-4 flex w-full min-w-0 max-w-full gap-3 overflow-x-auto pb-2" role="group" aria-label="Elegir fotografía">
          {imagenes.map((imagen, index) => (
            <button
              type="button"
              class="h-20 w-20 shrink-0 border border-[#e6e7e3] bg-white p-1 transition-colors aria-pressed:border-[#181a19] aria-pressed:ring-1 aria-pressed:ring-[#181a19] cursor-pointer"
              data-image={imagen}
              data-index={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-label={`Ver foto ${index + 1} de ${p.nombre}`}
            >
              <img
                src={imagen}
                width="100"
                height="100"
                alt=""
                class="h-full w-full object-contain"
                loading="lazy"
              />
            </button>
          ))}
        </div>
        <p class="mt-2 text-[11px] text-[#747773]">
          Selecciona una miniatura para ver cada detalle.
        </p>
      </section>

      <!-- Columna 2: Ficha Técnica y Acciones de Compra -->
      <section class="min-w-0 break-words lg:pt-8">
        <p class="mb-4 text-[11px] tracking-[2px] text-[#747773] uppercase">
          {p.marca} / {categoria.nombre}
        </p>

        <h1 class="font-['Space_Grotesk'] text-4xl leading-tight font-medium tracking-tight md:text-5xl text-zinc-900">
          {p.nombre}
        </h1>

        <!-- Estado de disponibilidad -->
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <span id="product-status"
            class:list={[
              'px-3 py-1.5 text-[11px] font-medium',
              {
                'bg-[#edf5eb] text-[#306247]': p.estado === 'stock',
                'bg-[#faf3e5] text-[#815f2d]': p.estado === 'pedido',
                'bg-[#f3f4f0] text-[#656963]': p.estado === 'agotado'
              }
            ]}
          >
            {estado}
          </span>
          {usaTallas(p) && generoEtiqueta(p) && <span class="bg-[#f3f4f0] px-3 py-1.5 text-[11px] text-[#555b51]">{generoEtiqueta(p)}</span>}
          {p.condicion && <span class="text-xs text-[#747773]">{p.condicion}</span>}
        </div>

        <!-- Precio inicial desde; al elegir talla se muestra su precio exacto. -->
        <!-- <div class="mt-7 flex flex-wrap items-baseline gap-4" aria-live="polite" aria-atomic="true">
          <p id="product-price" class="text-3xl font-semibold text-zinc-900">{precio.texto}</p>
          <del id="product-previous-price" class="text-base text-[#888]" hidden={precio.anterior === null}>{precio.anterior !== null ? formatearPrecio(precio.anterior, precio.divisa) : ''}</del>
          <span id="product-discount" class="text-xs font-semibold text-[#42745b]" hidden={!precio.descuento}>{precio.descuento ? `−${precio.descuento}%` : ''}</span>
        </div> -->


        <!-- Precio del producto con soporte para oferta destacada -->
        <div class="mt-7 flex flex-wrap items-baseline gap-4" aria-live="polite" aria-atomic="true">
          <p id="product-price" class:list={['text-3xl font-bold tracking-tight', precio.anterior ? 'text-red-600' : 'text-zinc-900']}>
            {precio.texto}
          </p>
          <del id="product-previous-price" class="text-base text-[#888]" hidden={precio.anterior === null}>
            {precio.anterior !== null ? formatearPrecio(precio.anterior, precio.divisa) : ''}
          </del>
          <!-- <span id="product-discount" class="text-xs font-bold text-red-600 bg-white border border-red-100 px-2 py-0.5 rounded" hidden={!precio.descuento}>
            {precio.descuento ? `−${precio.descuento}%` : ''}
          </span> -->
        </div>
        {usaTallas(p) && (precio.porTalla || p.estado === 'pedido') && <p class="mt-3 text-xs leading-6 text-[#747773]">El precio puede variar según la talla. Selecciona la tuya para ver el importe disponible.</p>}
        {p.categoria === 'iphones' && p.estado === 'pedido' && <p class="mt-3 text-xs leading-6 text-[#747773]">Precio de importación en dólares estadounidenses (USD). Confirma el total y las condiciones de pago por WhatsApp.</p>}

        {(p.estado === 'pedido' || opciones.some(talla => esTallaAPedido(p,talla))) && <aside id="product-order-notice" hidden={p.estado !== 'pedido'} class="mt-6 flex gap-3 rounded-xl border border-zinc-200 bg-zinc-50 p-5" aria-label="Información del producto a pedido">
          <svg class="mt-1 shrink-0 text-zinc-500" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 5h12v12H2zM14 9h4l4 4v4h-8"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
          <div><p class="text-xs leading-6 text-zinc-600"><strong class="font-semibold text-zinc-900">Lo traemos para ti a pedido.</strong> La importación tiene un plazo orientativo de aproximadamente 2 semanas. Antes del pago, confirmamos por WhatsApp la disponibilidad, el precio final, desde cuándo se cuenta el plazo y la entrega para tu ubicación. Las actualizaciones de tu pedido se coordinan por WhatsApp.</p><a href="/metodos-de-pago/" class="mt-2 inline-block border-b border-zinc-300 text-xs leading-6 text-zinc-600">Conoce los métodos de pago</a></div>
        </aside>}

        <p class="mt-6 text-sm leading-7 whitespace-pre-line text-[#666b63]">
          {descripcion}
        </p>

        <!-- Especificaciones técnicas -->
        <dl class="mt-6 grid grid-cols-2 gap-3 border-y border-[#e6e7e3] py-5 text-xs">
          <dt class="text-[#747773]">Modelo</dt>
          <dd class="text-zinc-900 font-medium">{p.modelo}</dd>
          
          {p.tipo && (
            <>
              <dt class="text-[#747773]">Tipo</dt>
              <dd class="text-zinc-900 font-medium">{p.tipo}</dd>
            </>
          )}
          
          {p.bateria && (
            <>
              <dt class="text-[#747773]">Batería</dt>
              <dd class="text-zinc-900 font-medium">{p.bateria}</dd>
            </>
          )}
        </dl>

        <!-- Selector de variante (Talla o Capacidad) -->
        {opciones.length > 0 && (
          <div class="mt-6">
            <label for="product-variant" class="mb-3 block text-xs font-medium text-zinc-900">
              {variante === 'Talla' ? 'Elige tu talla' : 'Capacidad'}
            </label>
            <select
              id="product-variant"
              class="w-full border border-[#d5d9d0] bg-white px-4 py-3.5 text-sm outline-none focus:border-zinc-900"
              aria-label={`${variante} de ${p.nombre}`}
            >
              {usaTallas(p) && <option value="">Selecciona una talla</option>}
              {opciones.map((opcion) => (
                <option value={opcion}>{p.categoria === 'zapatillas' ? etiquetaTalla(opcion) : opcion}{p.preciosPorTalla?.length ? ` — ${precioProducto(p, opcion).texto}` : ''}</option>
              ))}
            </select>
          </div>
        )}

        {usaTallas(p) && opciones.some(talla => esTallaAPedido(p,talla)) && <p class="mt-3 text-xs leading-6 text-zinc-500">¿Buscas otra talla? Elige “Otras tallas a pedido” para consultar su importación. El precio de las tallas en stock no se aplica a ese pedido.</p>}

        {p.categoria === 'zapatillas' && <GuiaTallas producto={p}/>}

        <!-- Botón a WhatsApp interactivo con datos seleccionados -->
        <a
          id="product-whatsapp"
          href={whatsappUrl(mensaje)}
          class="mt-7 flex w-full items-center justify-center gap-3 bg-[#181a19] px-5 py-4 text-sm font-medium text-white transition-colors hover:bg-[#42745b]"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src="/brand-whatsapp.svg" alt="" width="20" height="20" class="brightness-0 invert" />
          <span id="product-whatsapp-label">{p.estado === 'agotado'
            ? 'Consultar reposición'
            : p.estado === 'pedido'
            ? 'Consultar pedido por WhatsApp'
            : 'Consultar por WhatsApp'}</span>
          
        </a>

        <p class="mt-3 text-center text-[11px] leading-5 text-[#747773]">
          Confirmamos disponibilidad, precio final y entrega contigo.
        </p>

        {modoDemo && (
          <p class="mt-5 bg-[#f5f5f2] p-4 text-[11px] leading-5 text-[#747773]">
            Producto de muestra. Las fotos y precios son referenciales; reemplázalos con las imágenes y detalles reales de tu producto.
          </p>
        )}

        <a
          class="mt-8 inline-block border-b border-[#bbbfb7] pb-1 text-xs text-zinc-700 hover:border-zinc-900 transition-colors"
          href={`/catalogo/${p.categoria}/`}
        >
          ← Volver a {categoria.nombre.toLowerCase()}
        </a>
      </section>

    </div>
  </main>
</Layout>

<script>
  import { whatsappUrl } from '../../data/tienda';
  import { precioProducto, mensajeProducto, formatearPrecio, esTallaAPedido, usaTallas } from '../../lib/precios';
  import type { Producto } from '../../data/productos';

  // Manejo de cambio de imagen principal al hacer clic en miniaturas
  const main = document.querySelector<HTMLImageElement>('#product-main-image');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-image]')];

  thumbs.forEach((button) =>
    button.addEventListener('click', () => {
      if (!main) return;
      main.src = button.dataset.image!;
      const index = Number(button.dataset.index) + 1;
      main.alt = `${document.querySelector('h1')?.textContent}, foto ${index} de ${thumbs.length}`;

      thumbs.forEach((thumb) =>
        thumb.setAttribute('aria-pressed', String(thumb === button))
      );

      const counter = document.querySelector('#photo-counter');
      if (counter) counter.textContent = `${index} / ${thumbs.length}`;
    })
  );

  // El importe visible y el mensaje utilizan siempre la misma variante y divisa.
  const productRoot = document.querySelector<HTMLElement>('[data-product]');
  const select = document.querySelector<HTMLSelectElement>('#product-variant');
  const link = document.querySelector<HTMLAnchorElement>('#product-whatsapp');
  if (productRoot && link) {
    const producto: Producto = JSON.parse(productRoot.dataset.product!);
    function actualizarPrecio() {
      const talla = usaTallas(producto) ? select?.value || '' : '';
      const precioData = precioProducto(producto, talla);
      const priceEl = document.querySelector<HTMLElement>('#product-price')!;
      const previous = document.querySelector<HTMLElement>('#product-previous-price')!;
      const discount = document.querySelector<HTMLElement>('#product-discount')!;

      priceEl.textContent = precioData.texto;
      priceEl.className = precioData.anterior ? 'text-3xl font-bold tracking-tight text-red-600' : 'text-3xl font-semibold text-zinc-900';
      previous.hidden = precioData.anterior === null;
      previous.textContent = precioData.anterior !== null ? formatearPrecio(precioData.anterior, precioData.divisa) : '';
      if (discount) { discount.hidden = !precioData.descuento;
      discount.textContent = precioData.descuento ? `−${precioData.descuento}%` : ''; }

      const pedido = producto.estado === 'pedido' || esTallaAPedido(producto,talla);
      const aviso = document.querySelector<HTMLElement>('#product-order-notice');
      if (aviso) aviso.hidden = !pedido;
      const status = document.querySelector<HTMLElement>('#product-status');
      if (status) {
        status.textContent = pedido ? 'A pedido / importación' : producto.estado === 'stock' ? 'En stock' : 'Agotado';
        status.className = `px-3 py-1.5 text-[11px] font-medium ${pedido ? 'bg-[#faf3e5] text-[#815f2d]' : producto.estado === 'stock' ? 'bg-[#edf5eb] text-[#306247]' : 'bg-[#f3f4f0] text-[#656963]'}`;
      }
      const label = document.querySelector('#product-whatsapp-label');
      if (label) label.textContent = producto.estado === 'agotado' ? 'Consultar reposición' : pedido ? 'Consultar pedido por WhatsApp' : 'Consultar por WhatsApp';

      link!.href = whatsappUrl(mensajeProducto(producto, select?.value || ''));
    }
    select?.addEventListener('change', actualizarPrecio);
    actualizarPrecio();
  }
</script>
